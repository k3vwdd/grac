# --- Terraform ---
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files often hold account IDs/emails. Commit a .example instead.
*.tfvars
*.tfvars.json

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# Do NOT ignore .terraform.lock.hcl — it pins provider versions and belongs in git.

# --- Secrets / local ---
.env
.env.*
*.pem
*.key

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
